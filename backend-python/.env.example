# --- Environment ---
# "development" (default) or "production".
# In production, Secure cookies are enforced and the app refuses to start
# with the default JWT secret.
ENVIRONMENT=development

# --- Database ---
# SQLite for local dev; switch to postgresql://... for production.
DATABASE_URL=sqlite:///./dev.db

# --- JWT / Auth ---
# CHANGE THIS in production. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=sitara-dev-secret-change-in-production
# Short-lived access token (Authorization header).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Long-lived, rotating refresh token (httpOnly cookie).
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated allowed origins for the browser frontend.
CORS_ORIGINS=http://localhost:3000

PORT=3001

# --- AI (Google Gemini) — leave empty for simulated template-based replies ---
GEMINI_API_KEY=

# --- WhatsApp (Meta Cloud API) — leave empty for simulated mode ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sitara-dev-verify
